#!/usr/bin/env bash
# ABOUTME: Runs the workspace's canonical local verification.
# ABOUTME: Checks contracts, executable behavior, and locked dependency provenance.
set -euo pipefail
cd "$(dirname "$0")/.."
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --locked -- -D warnings
cargo test --workspace --locked
cargo run --quiet --locked -p earph-harness -- catalog-check --catalog docs/requirements.json
cargo run --quiet --locked -p earph-harness -- dependency-check --inventory docs/dependency-lock.json
